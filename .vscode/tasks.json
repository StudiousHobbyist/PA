
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build SFML",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-Wall",
                "-Wextra",

                "${workspaceFolder}\\src\\main.cpp",

                "-I${workspaceFolder}\\src",
                "-I${workspaceFolder}\\includes",
                "-IC:\\msys64\\ucrt64\\include",

                "-LC:\\msys64\\ucrt64\\lib",

                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",

                "-o",
                "${workspaceFolder}\\PenguinAdventure.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build SFML application with MSYS2 UCRT64"
        },

        {
            "label": "Run SFML",
            "type": "shell",
            "command": "${workspaceFolder}\\PenguinAdventure.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Build SFML"
            ],
            "problemMatcher": []
        }
    ]
}

